# 本地 python -m app.dev 自动加载项目根目录 .env；生产启动通过 shell 或部署平台注入。
WIKI_DATA_DIR=.data
WIKI_LLM_BASE_URL=https://api.openai.com/v1
WIKI_LLM_API_KEY=
WIKI_LLM_MODEL=
# 可选：设置后，首页需输入访问令牌；互联网部署必须设置并启用 HTTPS。
WIKI_ACCESS_TOKEN=
WIKI_GIT_HOSTS=github.com,gitlab.com,bitbucket.org

# 本机使用 Fake-IP DNS 代理且 Git 解析至 198.18.0.0/15 时可设为 1；默认拒绝。
WIKI_GIT_ALLOW_FAKE_IP=0

# 默认生产模式；仅本地开发可同时显式开启，推荐 python -m app.dev。
WIKI_ENV=production
WIKI_DEV_MODE=0

# 唯一需要适配模型的预算项：上下文总窗口（输入+输出），单位 token，默认 128000，最小 8192。
# 系统自动推导单次输出预算及工具读取量，不需要另配 max_tokens。
WIKI_LLM_CONTEXT_TOKENS=128000
